<!DOCTYPE html>
<html>
<head>
  <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
</head>
<body>
  <h1>Contact from Portfolio Website</h1>
  <p>
    You have received a message from your portfolio website's contact form.
  </p>
  <p>
    <strong>Name:</strong> <%= @name %><br>
    <strong>Email:</strong> <%= @email %><br>
  </p>
  <p>
    <strong>Message:</strong><br>
    <%= @message %>
  </p>
</body>
</html>
