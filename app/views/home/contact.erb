<div class="page">
  <div class="contact-section">
    <h1>Contact Me</h1>
    
    <% if flash[:success] %>
      <div class="alert alert-success">
        <%= flash[:success] %>
      </div>
    <% end %>
    
    <% if flash[:error] %>
      <div class="alert alert-danger">
        <%= flash[:error] %>
      </div>
    <% end %>
    
    <div class="contact-form-container">
      <%= form_tag '/send_message', method: :post, class: 'contact-form', id: 'contact-form', onsubmit: "document.getElementById('submit-btn').style.display='none'; document.getElementById('loading-animation').style.display='block';" do %>
        <div class="form-group">
          <label for="name">Your name</label>
          <%= text_field_tag :name, nil, class: 'form-control', required: true %>
        </div>
        
        <div class="form-group">
          <label for="email">Your email address</label>
          <%= email_field_tag :email, nil, class: 'form-control', required: true %>
        </div>
        
        <div class="form-group">
          <label for="subject">Subject</label>
          <%= text_field_tag :subject, nil, class: 'form-control', required: true %>
        </div>
        
        <div class="form-group">
          <label for="message">Message</label>
          <%= text_area_tag :message, nil, class: 'form-control', rows: 5, required: true %>
        </div>
        
        <div class="submit-section">
          <button type="submit" class="submit-btn" id="submit-btn">Send Message</button>
          <div class="loading-animation" id="loading-animation">
            <span>Sending...</span>
          </div>
        </div>
      <% end %>
    </div>
    
    <div class="back-link">
      <%= link_to "Back to Home", root_path %>
    </div>
  </div>
</div>
