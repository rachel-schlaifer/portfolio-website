<!DOCTYPE html>
<html>
<head>
  <title>Ruby Getting Started on Heroku</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%= javascript_include_tag 'application', 'data-turbolinks-track' => true %>
  <%= stylesheet_link_tag  '//maxcdn.bootstrapcdn.com/bootstrap/3.3.4/css/bootstrap.min.css' %>
  <%= stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track' => true %>
  <%= javascript_include_tag  '//maxcdn.bootstrapcdn.com/bootstrap/3.3.4/js/bootstrap.min.js' %>
  <%= javascript_include_tag "https://kit.fontawesome.com/779d8e836e.js", crossorigin: "anonymous" %>
  <%= csrf_meta_tags %>
</head>
<body>

<div class="language-selector">
  <button class="language-btn active" data-lang="en">EN</button>
  <button class="language-btn" data-lang="jp">日本語</button>
  <button class="language-btn" data-lang="es">ES</button>
</div>

<div class="nav-links">
  <%= link_to "Home", root_path %>
  <%= link_to "Contact", contact_path %>
</div>

<%= yield %>

<%= javascript_include_tag "translations" %>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.language-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        changeLanguage(this.getAttribute('data-lang'));
      });
    });
  });
</script>

</body>
</html>
